# =============================================================================
# AIP Gest - Variables de entorno (PWA React + Vite + Supabase)
# =============================================================================
# Copia este archivo a .env y reemplaza los valores con los de tu proyecto Supabase.
# IMPORTANTE: Nunca subas el archivo .env con credenciales reales a un repositorio público.
# Solo usa la clave pública (anon key). Nunca expongas la service_role key en el navegador.

# URL de tu proyecto Supabase (ej: https://xxxx.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública/anónima de Supabase (anon key)
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Nombre de la aplicación
VITE_APP_NAME=AIP Gest
